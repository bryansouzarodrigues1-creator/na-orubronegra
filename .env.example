# URL pública do serviço persistente para palpites, notas, grupos e comunidade.
# As enquetes principais usam Netlify Blobs automaticamente no deploy Netlify.
# Não inclua uma barra no final.
PORTAL_BACKEND_ORIGIN=https://api.seu-dominio.com

# Opcional: token privado enviado pelo adaptador Netlify ao backend.
# Configure apenas no painel do Netlify; nunca coloque o valor real neste arquivo.
PORTAL_BACKEND_TOKEN=
